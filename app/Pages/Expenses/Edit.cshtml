@page "{id:int}"
@model ExpenseApp.Pages.Expenses.EditModel
@{
    ViewData["Title"] = "Edit Expense";
    ViewData["AppError"] = Model.Error;
}

<div class="top-bar">
    <h5 class="mb-0 fw-bold">Edit Expense #@RouteData.Values["id"]</h5>
    <a asp-page="Index" class="btn btn-outline-secondary btn-sm">← Back</a>
</div>

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card">
            <div class="card-header">Edit Details</div>
            <div class="card-body">
                <form method="post">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Category *</label>
                        <select asp-for="Input.CategoryId" asp-items="Model.CategoryOptions" class="form-select"></select>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Amount (£) *</label>
                            <input asp-for="Input.AmountGBP" type="number" step="0.01" min="0" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Date *</label>
                            <input asp-for="Input.ExpenseDate" type="date" class="form-control" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Description</label>
                        <textarea asp-for="Input.Description" rows="3" class="form-control"></textarea>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Receipt Reference</label>
                        <input asp-for="Input.ReceiptFile" class="form-control" />
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                        <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
